---
import StoreBadges from './StoreBadges.astro';

// Two-column game card for the homepage, mirroring the /sum-rush/ hero layout:
// device shot on one side, identity + CTAs on the other, alternating down the page.
// Everything navigable is a real <a> — the old version only had an onclick, so
// crawlers could not follow it and both game pages ended up orphaned.
export interface Props {
  icon: string;
  title: string;
  name: string;
  tagline: string;
  description: string;
  shot: string;
  shotAlt: string;
  iosUrl: string;
  androidUrl: string;
  gamePageUrl: string;
  howToPlayUrl: string;
  reverse?: boolean;
}

const {
  icon,
  title,
  name,
  tagline,
  description,
  shot,
  shotAlt,
  iosUrl,
  androidUrl,
  gamePageUrl,
  howToPlayUrl,
  reverse = false
} = Astro.props;
---

<article class:list={['game-card', { reverse }]}>
  <div class="shot">
    <a href={gamePageUrl} tabindex="-1" aria-hidden="true">
      <img src={shot} alt={shotAlt} width="720" height="1280" loading="lazy">
    </a>
  </div>

  <div class="info">
    <img src={icon} alt={`${name} app icon`} class="icon" width="84" height="84" loading="lazy">
    <h3><a href={gamePageUrl} set:html={title}></a></h3>
    <p class="tagline">{tagline}</p>
    <p class="description">{description}</p>

    <StoreBadges ios={iosUrl} android={androidUrl} game={name} align="start" />

    <p class="more">
      <a href={gamePageUrl}>About {name}</a>
      <span class="dot" aria-hidden="true">·</span>
      <a href={howToPlayUrl}>How to Play</a>
    </p>
  </div>
</article>

<style>
  .game-card {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 3.5rem;
    align-items: center;
    max-width: 1080px;
    margin: 0 auto;
    padding: 4.5rem 0;
  }

  .game-card + .game-card {
    border-top: 1px solid rgba(124, 152, 133, 0.18);
  }

  /* Alternate the shot side so the page does not read as two identical rows. */
  .game-card.reverse .shot {
    order: 2;
  }

  /* The two store mockups have different aspect ratios, so cap the height
     rather than the width — otherwise one card towers over the other. */
  .shot img {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 480px;
    height: auto;
    margin: 0 auto;
    border-radius: 20px;
    box-shadow: 0 18px 40px rgba(74, 74, 74, 0.22);
  }

  .icon {
    width: 84px;
    height: 84px;
    border-radius: 19px;
    display: block;
    margin: 0 0 1.25rem;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15);
  }

  .info h3 {
    font-size: 2.75rem;
    font-weight: 300;
    letter-spacing: 1px;
    line-height: 1;
    margin: 0 0 0.5rem;
  }

  .info h3 a {
    color: #4a4a4a;
    text-decoration: none;
  }

  .info h3 a:hover {
    text-decoration: underline;
    text-decoration-color: rgba(124, 152, 133, 0.6);
    text-underline-offset: 6px;
  }

  .tagline {
    font-size: 1.15rem;
    font-weight: 300;
    color: #7c9885;
    margin: 0 0 1rem;
  }

  .description {
    font-size: 1.05rem;
    line-height: 1.65;
    color: #666;
    margin: 0 0 1.75rem;
    max-width: 34rem;
  }

  .more {
    margin: 1.25rem 0 0;
    font-size: 0.95rem;
  }

  .more a {
    color: #7c9885;
    text-decoration: none;
  }

  .more a:hover {
    text-decoration: underline;
  }

  .dot {
    margin: 0 0.6rem;
    color: rgba(74, 74, 74, 0.35);
  }

  @media (max-width: 880px) {
    .game-card {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 3rem 0;
      text-align: center;
    }

    /* On one column the shot always leads, whatever the desktop order was. */
    .game-card.reverse .shot {
      order: 0;
    }

    .shot img {
      max-height: 360px;
    }

    .icon {
      margin: 0 auto 1rem;
    }

    .info h3 {
      font-size: 2.25rem;
    }

    .description {
      margin-left: auto;
      margin-right: auto;
    }

    .info :global(.store-badges) {
      justify-content: center;
    }
  }
</style>
